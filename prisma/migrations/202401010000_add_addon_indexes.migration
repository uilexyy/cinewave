-- Add index on userId for UserAddon for faster queries
CREATE INDEX IF NOT EXISTS "UserAddon_userId_idx" ON "UserAddon"("userId");

-- Add index on addonId for AddonRequestLog
CREATE INDEX IF NOT EXISTS "AddonRequestLog_addonId_idx" ON "AddonRequestLog"("addonId");

-- Add index on userId for Watchlist
CREATE INDEX IF NOT EXISTS "Watchlist_userId_idx" ON "Watchlist"("userId");

-- Add index on userId,titleId for Watchlist uniqueness
CREATE UNIQUE INDEX IF NOT EXISTS "Watchlist_userId_titleId_key" ON "Watchlist"("userId", "titleId");

-- Add index on userId,titleId,episodeId for WatchProgress
CREATE UNIQUE INDEX IF NOT EXISTS "WatchProgress_userId_titleId_episodeId_key" ON "WatchProgress"("userId", "titleId", "episodeId");

-- Add index on userId for PlaybackSession
CREATE INDEX IF NOT EXISTS "PlaybackSession_userId_idx" ON "PlaybackSession"("userId");

