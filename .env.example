# Base URL for the CineWave backend (Next.js API)
# Android: use your LAN IP or public domain, e.g. http://192.168.1.100:3000
# Web:    use your public domain or localhost, e.g. http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cinewave?schema=public"
